{
  "name": "meow-push-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-dependency cross-platform CLI for the MeoW push API (api.chuckfang.com)",
  "type": "module",
  "bin": {
    "meow": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "test": "node --test test/",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
